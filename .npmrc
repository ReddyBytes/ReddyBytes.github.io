# Force public npm registry for this project — overrides ~/.npmrc
# Apple corporate global config sets registry=https://npm.apple.com/
# This file forces ALL npm operations in this repo to use the public registry only.
#
# DO NOT COMMIT credentials or auth tokens here.
registry=https://registry.npmjs.org/

# Belt-and-suspenders — explicit lockfile rewriting in case host-replace is on globally
omit-lockfile-registry-resolved=false
replace-registry-host=npmjs.org
