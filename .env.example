# Backend — FastAPI / RAG environment variables
# Copy to .env (gitignored) and fill in real values.
# In production (Hugging Face Spaces), set these as Space secrets in the UI.

# ─── LLM providers ───────────────────────────────────────────────
# Get from https://aistudio.google.com/apikey (free tier: 1500 req/day)
GEMINI_API_KEY=

# Get from https://console.anthropic.com/settings/keys (used as fallback only)
ANTHROPIC_API_KEY=

# ─── Admin ───────────────────────────────────────────────────────
# Used for protected endpoints like POST /api/v1/reindex
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_BEARER_TOKEN=

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
# Dev: include localhost. Prod: include the live + custom domain.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://reddybytes.github.io

# ─── Logging ─────────────────────────────────────────────────────
# One of: debug, info, warning, error
LOG_LEVEL=info
