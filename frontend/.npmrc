# Force public npm registry inside frontend/ — defeats Apple ~/.npmrc
# Project-level .npmrc takes precedence over user-level (~/.npmrc).
# We have one here AND at the repo root for safety.
registry=https://registry.npmjs.org/

# Lockfile rewriting / host replacement
omit-lockfile-registry-resolved=false
replace-registry-host=npmjs.org

# Save exact versions on install (cleaner lockfile, deterministic CI builds)
save-exact=false
